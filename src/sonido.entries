# Puntos de entrada del controlador de sonido (sectores 25-56, copiado por el nucleo a la RAM de 0x4000).
#
# Su tabla de saltos de cabecera: el nucleo llama a 0x4000 (peticion, 0x8561) y a 0x4003 (cada cuadro, desde
# H.TIMI en 0x8514).
0x4000   # tabla de saltos: jp 0x4006 (peticion de sonido, A = el numero)
0x4003   # tabla de saltos: jp 0x41A6 (cada cuadro)
