# Notas de p20 (sectores 199-202, en 0x9800).
# --- tipos.py: datos medidos por el servicio que los lee (no editar a mano) ---
D 0x9AD7 0x9C95 casillas_9AD7  casillas en el RLE de 0x8EC7 (nucleo), hasta el 0; lo usa 0x984B (446 bytes)
D 0x9C95 0x9CBE casillas_9C95  casillas en el RLE de 0x8EC7 (nucleo), hasta el 0; lo usa 0x9862 (41 bytes)
D 0x9CBE 0x9CD6 casillas_9CBE  casillas en el RLE de 0x8EC7 (nucleo), hasta el 0; lo usa 0x98AF (24 bytes)
D 0x9CD6 0x9CF6 paleta_9CD6  paleta: 16 colores de 2 bytes; lo usa 0x9AD4 (32 bytes)
D 0x9CF6 0x9F4E vram_9CF6  RLE a la VRAM hasta el 0; lo usa 0x9826 (600 bytes)
# --- fin de tipos.py ---
# --- despachos.py: tablas de 0x822D (no editar a mano) ---
D 0x9876 0x987C saltos_9876  3 destinos del despachador (call 0x822D en 0x9873) (6 bytes)
F 0x9876 w8
D 0x98D0 0x98D8 saltos_98D0  4 destinos del despachador (call 0x822D en 0x98CD) (8 bytes)
F 0x98D0 w8
# --- fin de despachos.py ---
# --- explica.py: lo que se sabe medido de cada tramo sin nombre (no editar a mano) ---
D 0x9806 0x9810 leido_9806  lo usa el codigo: 0x9870 ld a,(09806h); 0x987E ld (09806h),a; 0x9887 ld (09807h),a (en +1); 0x988A ld hl,09807h (en +1) (10 bytes)
D 0x9921 0x9926 leido_9921  lo usa el codigo: 0x9913 ld hl,09921h -> 0x8221 (tabla de bytes: HL + A) (5 bytes)
D 0x9934 0x9939 leido_9934  lo usa el codigo: 0x9929 ld hl,09934h -> 0x8221 (tabla de bytes: HL + A) (5 bytes)
D 0x99B8 0x99D8 leido_99B8  lo usa el codigo: 0x998A ld hl,099b8h -> 0x8221 (tabla de bytes: HL + A); 0x999B ld hl,099c0h -> 0x8221 (tabla de bytes: HL + A) (en +8) (32 bytes)
D 0x9A1C 0x9A48 leido_9A1C  lo usa el codigo: 0x99DD ld hl,09a1ch -> 0x8221 (tabla de bytes: HL + A); 0x9A00 ld hl,09a1ch -> 0x8221 (tabla de bytes: HL + A) (44 bytes)
D 0x9F4E 0xA000 suelto_9F4E  nadie lo lee ni lo apunta (178 bytes)
# --- fin de explica.py ---
