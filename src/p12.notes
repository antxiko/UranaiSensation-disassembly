# --- despachos.py: tablas de 0x822D (no editar a mano) ---
D 0x9944 0x994A saltos_9944  3 destinos del despachador (call 0x822D en 0x9941) (6 bytes)
F 0x9944 w8
# --- fin de despachos.py ---
# --- explica.py: lo que se sabe medido de cada tramo sin nombre (no editar a mano) ---
D 0x982A 0x9842 leido_982A  lo usa el codigo: 0x9877 ld (0982ah),a; 0x987A ld a,(0982ah); 0x98B2 ld (0982bh),a (en +1); 0x98FC ld a,(0982bh) (en +1) (24 bytes)
D 0x9A41 0x9A45 leido_9A41  lo usa el codigo: 0x9A2D ld hl,09a41h -> 0x8221 (tabla de bytes: HL + A) (4 bytes)
D 0x9B8D 0x9B91 leido_9B8D  lo usa el codigo: 0x9B83 ld de,09b8dh (4 bytes)
D 0x9BF2 0x9BFC leido_9BF2  lo usa el codigo: 0x9BE2 ld hl,09bf2h -> 0x8221 (tabla de bytes: HL + A) (10 bytes)
D 0x9C1B 0x9E07 leido_9C1B  lo usa el codigo: 0x985F ld hl,09c1bh; 0x98CB ld hl,09c4dh -> 0x826C (tabla de palabras: la de A) (en +50); 0x98DB ld hl,09cefh -> 0x826C (tabla de palabras: la de A) (en +212); 0x9884 ld hl,09dc7h -> 0x8221 (tabla de bytes: HL + A) (en +428) (492 bytes)
D 0x9E2E 0x9E8B leido_9E2E  lo usa el codigo: 0x9AD8 ld hl,09e2eh -> 0x8221 (tabla de bytes: HL + A); 0x9B29 ld hl,09e6ah (en +60) (93 bytes)
D 0xA06B 0xA06E suelto_A06B  nadie lo lee ni lo apunta (3 bytes)
D 0xA19E 0xA200 leido_A19E  lo usa el codigo: 0xA047 ld hl,0a19eh -> 0x826C (tabla de palabras: la de A); 0x9FEE ld (0a1f8h),a (en +90); 0xA019 ld (0a1f8h),a (en +90); 0x9FBD ld (0a1f9h),a (en +91) (98 bytes)
